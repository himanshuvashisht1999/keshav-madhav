@push('scripts')
    <script>
        $(document).ready(function () {
            // Initialize Select2
            if ($.fn.select2) {
                $('.select2').select2({
                    theme: 'bootstrap4',
                    width: '100%'
                });
            }

            // Select All Logic
            $('#selectAll').change(function() {
                $('.box-checkbox').prop('checked', $(this).prop('checked')).trigger('change');
            });

            // Row Click Logic
            $('.box-row').click(function(e) {
                if ($(e.target).is('input') || $(e.target).is('label') || $(e.target).is('img')) return;
                const cb = $(this).find('.box-checkbox');
                cb.prop('checked', !cb.prop('checked')).trigger('change');
            });

            // Handle Checkbox Change
            $('.box-checkbox').change(function () {
                const tr = $(this).closest('.box-row');
                if ($(this).is(':checked')) {
                    tr.addClass('selected');
                } else {
                    tr.removeClass('selected');
                }
                calculateTotals();
            });

            function calculateTotals() {
                let count = 0;
                let totalAmount = 0;
                let totalQty = 0;

                $('.box-checkbox:checked').each(function () {
                    const tr = $(this).closest('.box-row');
                    const qty = parseFloat(tr.data('qty'));
                    const priceTotal = parseFloat(tr.data('price'));

                    count++;
                    totalAmount += priceTotal;
                    totalQty += qty;
                });

                $('#selectedCount').text(count);
                $('#totalAmount').text(totalAmount.toLocaleString('en-IN', {minimumFractionDigits: 2, maximumFractionDigits: 2}));
                $('#totalQtyVal').text(totalQty + ' Pcs');

                if (count > 0) {
                    $('#summaryBar').fadeIn();
                } else {
                    $('#summaryBar').fadeOut();
                    $('#selectAll').prop('checked', false);
                }
            }

            // Place Order AJAX
            $('#placeOrderBtn').click(function () {
                const btn = $(this);
                const originalText = btn.html();

                let boxIds = [];
                $('.box-checkbox:checked').each(function () {
                    boxIds.push($(this).val());
                });

                if (boxIds.length === 0) return;

                Swal.fire({
                    title: 'Confirm Order?',
                    text: "You are about to place an order for " + boxIds.length + " boxes.",
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#28a745',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Yes, Place Order'
                }).then((result) => {
                    if (result.isConfirmed) {
                        btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Placing Order...');

                        $.ajax({
                            url: "{{ route('agent.orders.store') }}",
                            method: "POST",
                            data: {
                                shop_id: "{{ $shop->id }}",
                                box_ids: boxIds,
                                _token: "{{ csrf_token() }}"
                            },
                            success: function (response) {
                                if (response.success) {
                                    Swal.fire('Success!', response.message, 'success').then(() => {
                                        window.location.href = response.redirect_url;
                                    });
                                } else {
                                    Swal.fire('Error', response.message, 'error');
                                    btn.prop('disabled', false).html(originalText);
                                }
                            },
                            error: function (xhr) {
                                Swal.fire('Error', xhr.responseJSON?.message || 'Something went wrong', 'error');
                                btn.prop('disabled', false).html(originalText);
                            }
                        });
                    }
                });
            });
        });
    </script>
@endpush
